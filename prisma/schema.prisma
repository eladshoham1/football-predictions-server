generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum MatchStage {
  GROUP_STAGE
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

model User {
  id                    String                  @id @default(cuid())
  googleId              String                  @unique @map("google_id")
  email                 String                  @unique
  name                  String
  avatarUrl             String?                 @map("avatar_url")
  role                  UserRole                @default(USER)
  createdAt             DateTime                @default(now()) @map("created_at")
  lastLoginAt           DateTime?               @map("last_login_at")
  matchPredictions      MatchPrediction[]
  groupPredictions      GroupPrediction[]
  bracketPredictions    BracketPrediction[]
  tournamentPredictions TournamentPrediction[]

  @@map("users")
}

model Team {
  id                        String                  @id @default(cuid())
  externalApiId             String?                 @unique @map("external_api_id")
  name                      String
  code                      String                  @unique
  flagUrl                   String?                 @map("flag_url")
  groupName                 String?                 @map("group_name")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  homeMatches               Match[]                 @relation("HomeTeam")
  awayMatches               Match[]                 @relation("AwayTeam")
  players                   Player[]
  groupFirstPlacePredictions GroupPrediction[]      @relation("FirstPlace")
  groupSecondPlacePredictions GroupPrediction[]     @relation("SecondPlace")
  groupThirdPlacePredictions GroupPrediction[]      @relation("ThirdPlace")
  groupFourthPlacePredictions GroupPrediction[]     @relation("FourthPlace")
  bracketPredictions        BracketPrediction[]
  tournamentWinnerPredictions TournamentPrediction[]

  @@map("teams")
}

model Player {
  id                        String                  @id @default(cuid())
  externalApiId             String?                 @unique @map("external_api_id")
  teamId                    String                  @map("team_id")
  name                      String
  position                  String?
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  team                      Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  goldenBootPredictions     TournamentPrediction[]

  @@map("players")
  @@index([teamId])
}

model Match {
  id              String              @id @default(cuid())
  externalApiId   String?             @unique @map("external_api_id")
  stage           MatchStage
  round           Int?
  groupName       String?             @map("group_name")
  homeTeamId      String              @map("home_team_id")
  awayTeamId      String              @map("away_team_id")
  kickoffTime     DateTime            @map("kickoff_time")
  homeScore       Int?                @map("home_score")
  awayScore       Int?                @map("away_score")
  penaltyWinnerId String?             @map("penalty_winner_id")
  status          MatchStatus         @default(SCHEDULED)
  venue           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  homeTeam        Team                @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam        Team                @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  predictions     MatchPrediction[]

  @@map("matches")
  @@index([kickoffTime])
  @@index([stage])
  @@index([status])
}

model MatchPrediction {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  matchId             String   @map("match_id")
  predictedHomeScore  Int      @map("predicted_home_score")
  predictedAwayScore  Int      @map("predicted_away_score")
  pointsAwarded       Int      @default(0) @map("points_awarded")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match               Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@map("match_predictions")
  @@index([userId])
  @@index([matchId])
}

model GroupPrediction {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  groupName         String   @map("group_name")
  firstPlaceTeamId  String   @map("first_place_team_id")
  secondPlaceTeamId String   @map("second_place_team_id")
  thirdPlaceTeamId  String?  @map("third_place_team_id")
  fourthPlaceTeamId String?  @map("fourth_place_team_id")
  pointsAwarded     Int      @default(0) @map("points_awarded")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstPlaceTeam    Team     @relation("FirstPlace", fields: [firstPlaceTeamId], references: [id], onDelete: Cascade)
  secondPlaceTeam   Team     @relation("SecondPlace", fields: [secondPlaceTeamId], references: [id], onDelete: Cascade)
  thirdPlaceTeam    Team?    @relation("ThirdPlace", fields: [thirdPlaceTeamId], references: [id], onDelete: Cascade)
  fourthPlaceTeam   Team?    @relation("FourthPlace", fields: [fourthPlaceTeamId], references: [id], onDelete: Cascade)

  @@unique([userId, groupName])
  @@map("group_predictions")
  @@index([userId])
}

model BracketPrediction {
  id              String     @id @default(cuid())
  userId          String     @map("user_id")
  matchId         String     @map("match_id")
  predictedTeamId String     @map("predicted_team_id")
  pointsAwarded   Int        @default(0) @map("points_awarded")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  predictedTeam   Team       @relation(fields: [predictedTeamId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@map("bracket_predictions")
  @@index([userId])
  @@index([matchId])
}

model TournamentPrediction {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  winnerTeamId       String   @map("winner_team_id")
  goldenBootPlayerId String?  @map("golden_boot_player_id")
  winnerPointsAwarded Int     @default(0) @map("winner_points_awarded")
  goldenBootPointsAwarded Int @default(0) @map("golden_boot_points_awarded")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  winnerTeam         Team     @relation(fields: [winnerTeamId], references: [id], onDelete: Cascade)
  goldenBootPlayer   Player?  @relation(fields: [goldenBootPlayerId], references: [id], onDelete: Cascade)

  @@map("tournament_predictions")
}

model ScoringConfig {
  id                        String   @id @default(cuid())
  correctWinner             Int      @default(3) @map("correct_winner")
  correctGoalDifference     Int      @default(2) @map("correct_goal_difference")
  exactScore                Int      @default(5) @map("exact_score")
  groupAdvancingTeam        Int      @default(5) @map("group_advancing_team")
  groupCorrectPosition      Int      @default(10) @map("group_correct_position")
  roundOf32                 Int      @default(2) @map("round_of_32")
  roundOf16                 Int      @default(4) @map("round_of_16")
  quarterFinal              Int      @default(8) @map("quarter_final")
  semiFinal                 Int      @default(12) @map("semi_final")
  final                     Int      @default(20)
  tournamentWinner          Int      @default(30) @map("tournament_winner")
  goldenBoot                Int      @default(25) @map("golden_boot")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("scoring_config")
}

model SyncLog {
  id          String   @id @default(cuid())
  status      String
  message     String?
  syncedCount Int      @default(0) @map("synced_count")
  errorCount  Int      @default(0) @map("error_count")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("sync_logs")
  @@index([createdAt])
}
